# Backend (read by pydantic-settings and docker compose)
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://fs:fs@localhost:5432/fs
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_BASE_CURRENCY=EUR
FX_API_URL=https://api.frankfurter.app

# Local development only: accept the unauthenticated X-Org-Id header as an OWNER principal. Needs a
# non-prod APP_ENV as well, so a lost APP_ENV in production does not open the door by itself.
# Never set it on a deployment: leave it commented anywhere but a laptop.
# ALLOW_DEV_PRINCIPAL=true
# Local development only: let an ERP URL point at a private address (the demo Odoo on
# host.docker.internal). Same rule: needs a non-prod APP_ENV as well.
# ALLOW_PRIVATE_OUTBOUND=true
# Ports an outbound connection (a customer's Odoo) may use besides 80, 443, 8069 and 8071.
# OUTBOUND_EXTRA_PORTS=[8443]

# Clerk (Phase 1 auth). Leave empty in dev to use the X-Org-Id header instead.
# CLERK_JWKS_URL=https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-frontend-api>.clerk.accounts.dev
# CLERK_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=["https://app.example.com"]
# MIGRATIONS_DATABASE_URL=   owner connection for alembic when DATABASE_URL uses the limited role

# Frontend (frontend/.env.local)
# API_URL=http://localhost:8001                 server-side calls
# ORG_ID=123e4567-e89b-12d3-a456-426614174000  dev only: used when Clerk keys are absent
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
